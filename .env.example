# Network: TESTNET or MAINNET
WATERX_NETWORK=TESTNET

# Your SUI private key (bech32 format, starts with suiprivkey1...)
# Generated automatically by `npm run setup` if not set
SUI_PRIVATE_KEY=
# WaterX account ID (set automatically by `npm run setup`)
WATERX_ACCOUNT_ID=

# WaterX account object address (set automatically by `npm run setup`)
WATERX_ACCOUNT_OBJECT_ADDRESS=

# WaterX REST API URL (optional — enables market data, analytics, etc.)
WATERX_API_URL=
